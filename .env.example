# =============================================================================
# INDRA — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://indra_user:your_password_here@localhost:5432/indra_db
POSTGRES_USER=indra_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=indra_db

# -----------------------------------------------------------------------------
# Redis (optional — used for API response caching)
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# -----------------------------------------------------------------------------
# LLM Provider Configuration
# -----------------------------------------------------------------------------
# INDRA uses an LLM abstraction layer. Set the provider and API key.
# Supported providers: openai, anthropic, google, local
# The actual application LLM will be selected through a controlled benchmark.
# See docs/07-ai-ml/AI_MODEL_STRATEGY.md
#
LLM_PROVIDER=openai
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL_NAME=gpt-4o-mini
# LLM_BASE_URL=                # Override for local/custom endpoints

# -----------------------------------------------------------------------------
# External Data Source API Keys
# -----------------------------------------------------------------------------
# GDELT — No API key required (public BigQuery / direct download)
# GDELT_BIGQUERY_PROJECT=your_gcp_project_id  # Optional for BigQuery access

# ACLED — Free for research, requires registration
ACLED_API_KEY=your_acled_key_here
ACLED_EMAIL=your_email@example.com

# EIA — Free, requires registration at api.eia.gov
EIA_API_KEY=your_eia_key_here

# NewsAPI — Free tier (24hr delay on free plan)
NEWSAPI_KEY=your_newsapi_key_here

# OFAC — No API key required (public data)

# RBI — No API key required (public data)

# -----------------------------------------------------------------------------
# Application Settings
# -----------------------------------------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_PORT=8000
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Scheduler Settings (APScheduler intervals in seconds)
# -----------------------------------------------------------------------------
GDELT_POLL_INTERVAL=900          # 15 minutes
ACLED_POLL_INTERVAL=86400        # 24 hours
EIA_POLL_INTERVAL=86400          # 24 hours
RBI_POLL_INTERVAL=86400          # 24 hours
NEWS_POLL_INTERVAL=3600          # 1 hour
OFAC_POLL_INTERVAL=86400         # 24 hours
