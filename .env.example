# =============================================================================
# INDRA — Environment Configuration Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=true
FRONTEND_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Database (local Docker PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://indra_user:your_password_here@localhost:5432/indra_db
POSTGRES_USER=indra_user
POSTGRES_PASSWORD=your_password_here
POSTGRES_DB=indra_db

# -----------------------------------------------------------------------------
# LLM Provider Configuration (Step 8A)
# -----------------------------------------------------------------------------
LLM_PROVIDER=openrouter
LLM_MODEL=openai/gpt-4o-mini
OPENROUTER_API_KEY=               # your OpenRouter API key (https://openrouter.ai/keys)
# --- Step 8B Ingestion ---
INGESTION_ENABLED=false
EIA_API_KEY=
ACLED_API_KEY=
ACLED_EMAIL=
RSS_FEED_URLS=https://feeds.reuters.com/reuters/energyNews,https://feeds.bbci.co.uk/news/world/rss.xml

# Polling intervals use defaults in settings.py unless overridden:
# INGESTION_GDELT_INTERVAL_MINUTES=15
# INGESTION_RSS_INTERVAL_MINUTES=60
